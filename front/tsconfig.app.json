{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "src/**/*.ts",
        "src/**/*.vue",
        "../back/src/public/js/utils/validations/loginValidation.js",
        "../back/src/public/js/utils/validations/baseValidations.js",
        "../back/src/public/js/constants/apiMessages.js",
        "../back/src/shared/constants/auth.js",
        "../back/src/shared/constants/inputValidation.js",
        "../back/src/shared/messages/goodsReceiptMessages.js",
        "../back/src/public/js/utils/validations/validators.js",
        "../back/src/public/js/utils/validations/fieldValidations.js",
        "../back/src/shared/constants/inventory.js",
        "../back/src/shared/constants/permissions.js",
        "../back/src/shared/inventory/wasteMeasurements.js",
        "../back/src/shared/validation/weightValidations.js",
        "../back/src/shared/utils/numberUtils.js",
        "../back/src/shared/constants/catalogs.js"
    ],
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "paths": {
            "@nexus/login-validation": [
                "../back/src/public/js/utils/validations/loginValidation.js"
            ],
            "@nexus/api-messages": ["../back/src/public/js/constants/apiMessages.js"],
            "@nexus/waste-measurements": ["../back/src/shared/inventory/wasteMeasurements.js"],
            "@nexus/permissions": ["../back/src/shared/constants/permissions.js"],
            "@nexus/catalogs": ["../back/src/shared/constants/catalogs.js"],
            "@nexus/form-validation": ["../back/src/public/js/utils/validations/validators.js"]
        },
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["vite/client"],
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
    }
}
