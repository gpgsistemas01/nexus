{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "src/**/*.ts",
        "src/**/*.vue",
        "../back/src/shared/validation/loginValidation.js",
        "../back/src/shared/validation/baseValidations.js",
        "../back/src/shared/messages/apiMessages.js",
        "../back/src/shared/constants/auth.js",
        "../back/src/shared/constants/inputValidation.js",
        "../back/src/shared/constants/inventoryImport.js",
        "../back/src/shared/constants/historicalDelivery.js",
        "../back/src/shared/messages/goodsReceiptMessages.js",
        "../back/src/shared/validation/validators.js",
        "../back/src/shared/validation/fieldValidations.js",
        "../back/src/shared/constants/inventory.js",
        "../back/src/shared/constants/permissions.js",
        "../back/src/shared/inventory/wasteMeasurements.js",
        "../back/src/shared/validation/weightValidations.js",
        "../back/src/shared/utils/numberUtils.js",
        "../back/src/shared/constants/catalogs.js",
        "../back/src/shared/inventory/goodsReceiptCalculations.js",
        "../back/src/shared/utils/timeZone.js",
        "../back/src/shared/constants/apiSuccessCodes.js",
        "../back/src/shared/inventory/issueHeaderRules.js",
        "../back/src/shared/constants/fulfillmentStatuses.js",
        "../back/src/shared/utils/formatters.js"
    ],
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "paths": {
            "@nexus/historical-deliveries": ["../back/src/shared/constants/historicalDelivery.js"],
            "@nexus/inventory-imports": ["../back/src/shared/constants/inventoryImport.js"],
            "@nexus/piece-quantity": ["../back/src/shared/inventory/pieceQuantity.js"],
            "@nexus/input-validation": ["../back/src/shared/constants/inputValidation.js"],
            "@nexus/login-validation": ["../back/src/shared/validation/loginValidation.js"],
            "@nexus/api-messages": ["../back/src/shared/messages/apiMessages.js"],
            "@nexus/waste-measurements": ["../back/src/shared/inventory/wasteMeasurements.js"],
            "@nexus/permissions": ["../back/src/shared/constants/permissions.js"],
            "@nexus/catalogs": ["../back/src/shared/constants/catalogs.js"],
            "@nexus/form-validation": ["../back/src/shared/validation/validators.js"],
            "@nexus/purchase-calculations": [
                "../back/src/shared/inventory/goodsReceiptCalculations.js"
            ],
            "@nexus/date-time": ["../back/src/shared/utils/timeZone.js"],
            "@nexus/api-success-codes": ["../back/src/shared/constants/apiSuccessCodes.js"],
            "@nexus/issue-header-rules": ["../back/src/shared/inventory/issueHeaderRules.js"],
            "@nexus/issue-statuses": ["../back/src/shared/constants/fulfillmentStatuses.js"],
            "@nexus/numbers": ["../back/src/shared/utils/numberUtils.js"]
        },
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["vite/client"],
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
    }
}
