{
  "name": "nexus-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "type-check:watch": "vue-tsc --build --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run test:unit && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:system": "playwright test --config playwright.system.config.ts",
    "format": "npm run lint:fix && prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{js,ts,json}\""
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@mdi/js": "7.4.47",
    "axios": "^1.20.0",
    "sweetalert2": "^11.26.25",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.12.1"
  }
}
