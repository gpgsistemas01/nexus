  "/api/admin/catalogs/{catalog}": {
    "get": {
      "operationId": "getManagedCatalog",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "catalog",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "departments",
              "roles",
              "presentations",
              "unit-measures",
              "reasons",
              "fulfillment-statuses"
            ]
          }
        },
        {
          "name": "start",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "name": "length",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "default": 10
          }
        },
        {
          "name": "search[value]",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data",
                  "recordsTotal",
                  "recordsFiltered"
                ],
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "recordsTotal": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "recordsFiltered": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        }
      }
    },
    "post": {
      "operationId": "postManagedCatalog",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "catalog",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "departments",
              "roles",
              "presentations",
              "unit-measures",
              "reasons",
              "fulfillment-statuses"
            ]
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "title": "Áreas",
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "title": "Roles",
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "title": "Presentaciones",
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "title": "Unidades de medida",
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10
                    }
                  },
                  "required": [
                    "name",
                    "symbol"
                  ],
                  "additionalProperties": false
                },
                {
                  "title": "Motivos de ajuste",
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "isActive": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "isActive"
                  ],
                  "additionalProperties": false
                },
                {
                  "title": "Estados de cumplimiento",
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 50
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Respuesta correcta.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data",
                  "code"
                ],
                "properties": {
                  "data": {
                    "type": "object"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "400": {
          "$ref": "../openapi.json#/components/responses/ValidationError"
        }
      }
    }
  },
