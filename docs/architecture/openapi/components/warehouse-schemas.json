        "type": "number"
      },
      "maxUnitCost": {
        "type": "number"
      },
      "isActive": {
        "type": "boolean"
      },
      "initialQuantity": {
        "type": "number",
        "minimum": 0,
        "description": "Cantidad inicial de unidades de merma. Si es positiva se guarda en WasteStockEntry.quantity y se suma al saldo; cero no genera entrada."
      },
      "observations": {
        "type": "string"
      },
      "coneWeightKg": {
        "type": [
          "number",
          "string",
          "null"
        ],
        "maximum": 999.99,
        "description": "Peso del cono en kg por unidad de merma de Rollo, mayor o igual que cero. Capturar ambos pesos o dejar ambos vac\u00edos; hasta tres enteros y dos decimales.",
        "multipleOf": 0.01,
        "pattern": "^(?:|\\d{1,3}(\\.\\d{1,2})?)(?![\\s\\S])",
        "minimum": 0
      },
      "totalWeightKg": {
        "type": [
          "number",
          "string",
          "null"
        ],
        "exclusiveMinimum": 0,
        "maximum": 999.99,
        "description": "Peso total con cono en kg por unidad de merma de Rollo, mayor que el cono y hasta 999.99 kg. Capturar ambos pesos o dejar ambos vac\u00edos; hasta tres enteros y dos decimales.",
        "multipleOf": 0.01,
        "pattern": "^(?:|(?=.*[1-9])\\d{1,3}(\\.\\d{1,2})?)(?![\\s\\S])"
      },
      "referenceRollTotalWeightKg": {
        "type": [
          "number",
          "string",
          "null"
        ],
        "exclusiveMinimum": 0,
        "maximum": 999.99,
        "multipleOf": 0.01,
        "description": "Peso del rollo completo con cono, capturado desde merma. Se descuenta el mismo cono del sobrante; el largo procede del material.",
        "pattern": "^(?:|(?=.*[1-9])\\d{1,3}(\\.\\d{1,2})?)(?![\\s\\S])"
      },
      "operationId": {
        "type": "string",
        "format": "uuid",
        "description": "UUID v4 persistido antes de enviar. Un reintento del mismo actor conserva clave y captura; devuelve el resultado original sin nuevos efectos. No expira autom\u00e1ticamente."
      }
    },
    "additionalProperties": false,
    "required": [
      "name",
      "materialId",
      "supplierId",
      "maxUnitCost",
      "isActive",
      "initialQuantity",
      "operationId"
    ],
    "description": "Origen MATERIAL en m\u00b2. No se permite crear Rollo sin pesos ni sustituir el c\u00e1lculo con medidas manuales. Para Rollo capture coneWeightKg, totalWeightKg del sobrante y referenceRollTotalWeightKg del rollo completo con cono. El servidor descuenta el mismo cono de ambos pesos, toma el largo del material y calcula la longitud proporcional. No env\u00ede netos ni sampleLengthM/sampleNetWeightKg. El largo y neto de muestra se calculan sin persistirlos; esos dos campos quedan reservados a hist\u00f3ricos. Medidas, pesos y referencia quedan inmutables. Otras presentaciones en m\u00b2 usan medidas manuales sin pesos."
  },
