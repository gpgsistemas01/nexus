  "WasteCreateRequest": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "materialId": {
        "type": "string",
        "format": "uuid"
      },
      "supplierId": {
        "type": "string",
        "format": "uuid"
      },
      "base": {
        "type": "number"
      },
      "height": {
        "type": "number",
        "description": "Largo medido o valor mostrado por la estimación. El servidor recalcula height si lengthSource es ESTIMATED."
      },
      "minStock": {
        "type": "number"
      },
      "maxUnitCost": {
        "type": "number"
      },
      "isActive": {
        "type": "boolean"
      },
      "newStock": {
        "type": "number"
      },
      "observations": {
        "type": "string"
      },
      "coneWeightKg": {
        "type": [
          "number",
          "string",
          "null"
        ],
        "maximum": 100,
        "description": "Peso del cono en kg por unidad de merma de Rollo, mayor o igual que cero. Capturar ambos pesos o dejar ambos vacíos; hasta tres enteros y dos decimales.",
        "multipleOf": 0.01,
        "pattern": "^(?:|(?:\\d{1,2}(\\.\\d{1,2})?|0\\d{2}(\\.\\d{1,2})?|100(\\.0{1,2})?))(?![\\s\\S])",
        "minimum": 0
      },
      "totalWeightKg": {
        "type": [
          "number",
          "string",
          "null"
        ],
        "exclusiveMinimum": 0,
        "maximum": 100,
        "description": "Peso total con cono en kg por unidad de merma de Rollo, mayor que el cono y hasta 100 kg. Capturar ambos pesos o dejar ambos vacíos; hasta tres enteros y dos decimales.",
        "multipleOf": 0.01,
        "pattern": "^(?:|(?=.*[1-9])(?:\\d{1,2}(\\.\\d{1,2})?|0\\d{2}(\\.\\d{1,2})?|100(\\.0{1,2})?))(?![\\s\\S])"
      },
      "useConeReference": {
        "type": "boolean",
        "default": false,
        "description": "Resuelve el cono desde la oferta persistida; el valor enviado no reemplaza la referencia del servidor."
      },
      "lengthSource": {
        "type": "string",
        "enum": [
          "MEASURED",
          "ESTIMATED"
        ],
        "default": "MEASURED"
      }
    },
    "additionalProperties": false,
    "required": [
      "name",
      "materialId",
      "supplierId",
      "base",
      "height",
      "maxUnitCost",
      "isActive",
      "newStock"
    ],
    "allOf": [
      {
        "if": {
          "required": [
            "coneWeightKg"
          ],
          "properties": {
            "coneWeightKg": {
              "not": {
                "enum": [
                  null,
                  ""
                ]
              }
            }
          }
        },
        "then": {
          "required": [
            "totalWeightKg"
          ],
          "properties": {
            "totalWeightKg": {
              "not": {
                "enum": [
                  null,
                  ""
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "required": [
            "totalWeightKg"
          ],
          "properties": {
            "totalWeightKg": {
              "not": {
                "enum": [
                  null,
                  ""
                ]
              }
            }
          }
        },
        "then": {
          "required": [
            "coneWeightKg"
          ],
          "properties": {
            "coneWeightKg": {
              "not": {
                "enum": [
                  null,
                  ""
                ]
              }
            }
          }
        }
      }
    ]
  },
