  "WasteCreateRequest": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "materialId": {
        "type": "string",
        "format": "uuid",
        "description": "Material de origen con unidad m\u00b2 (por s\u00edmbolo o nombre metro cuadrado), excluyendo consumibles."
      },
      "supplierId": {
        "type": "string",
        "format": "uuid"
      },
      "base": {
        "type": "number",
        "description": "Dimensi\u00f3n final de la merma. El formulario incluye su valor aunque el input est\u00e9 deshabilitado. Para Rollo con pesos, el servidor recalcula la longitud y consulta la dimensi\u00f3n transversal del material."
      },
      "height": {
        "type": "number",
        "description": "Dimensi\u00f3n final de la merma. El formulario incluye su valor aunque el input est\u00e9 deshabilitado. Para Rollo con pesos, el servidor recalcula la longitud y consulta la dimensi\u00f3n transversal del material."
      },
