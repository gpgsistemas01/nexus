<% const header = {
    button: {
        id: 'menuCloseBtn',
        dismissTarget: 'offcanvas'
    },
    class: 'offcanvas-header',
    title: {
        id: 'menuTitle',
        content: appName,
        class: 'offcanvas-title'
    }
}; %>

<div
    id="mobileMenu"
    tabindex="-1"
    class="app-mobile-menu offcanvas offcanvas-start"
    data-mdb-theme="dark"
    aria-labelledby="<%= header.title.id %>"
    aria-hidden="true"
>
    <%- include('../../shared/header', { header }) %>

    <div class="px-3 pb-3">
        <%- include('../ui/appBrand', { className: 'app-brand--menu' }) %>
    </div>

    <div class="offcanvas-body d-flex flex-column">
        <div class="app-mobile-menu__nav">
            <div>
                <%- include('../ui/navList', { 
                    listClass: 'navbar-nav flex-column app-mobile-menu__list',
                    showIcons: true
                }) %>
            </div>
        </div>

        <div class="app-mobile-menu__footer">
            <%- include('../ui/logoutForm', {
                buttonClass: 'btn app-logout-btn app-logout-btn--mobile w-100',
                className: 'app-mobile-menu__logout-form'
            }) %>
        </div>
    </div>
</div>