<% const menuButton = {
    id: 'mobileMenuOffcanvasBtn',
    class: 'navbar-toggler p-2 app-header-action',
    attrs: {
        'data-mdb-ripple-init': '',
        'data-mdb-offcanvas-init': '',
        'data-mdb-target': '#mobileMenu',
        'aria-controls': 'mobileMenu',
        'aria-expanded': 'false'
    },
    content: '<i class="fas fa-bars me-2"></i>Menú'
}; %>

<div class="app-shell d-flex min-vh-100">

    <%- include('./sidebar/offcanvas') %>

    <aside class="app-sidebar app-sidebar--icon-only d-none d-lg-block p-3" data-mdb-theme="dark">
        <nav class="navbar navbar-expand-lg p-0">
            <div class="container-fluid flex-column align-items-stretch gap-4">
                <%- include('./ui/appBrand') %>

                <div class="row g-0" role="navigation">
                    <div class="col-12">
                        <%- include('./ui/navList', {
                            listClass: 'navbar-nav flex-column',
                            showLabels: false,
                            accordionId: 'appDesktopNavAccordion'
                        }) %>
                    </div>
                </div>
            </div>
        </nav>
    </aside>

    <div class="flex-fill d-flex flex-column">
        <header class="app-header navbar shadow-2 px-3 gap-2">

            <%- include('./ui/appBrand', { className: 'app-brand--header d-flex d-lg-none' }) %>

            <div class="d-lg-none">
                <%- include('../shared/controls/button', { button: menuButton }) %>
            </div>

            <div class="app-userbar d-flex align-items-center gap-2 gap-sm-3 ms-auto">
                <span
                    class="btn btn-link btn-floating app-header-action app-notifications-icon"
                    role="img"
                    aria-label="Notificaciones"
                >
                    <i class="fas fa-bell fs-5"></i>
                </span>

                <span class="app-user-name"><%= user.name %></span>

                <%- include('./ui/logoutForm', {
                    buttonClass: 'btn btn-sm btn-outline-primary app-header-action app-logout-btn app-logout-btn--header',
                    className: 'app-logout-form app-logout-form--header'
                }) %>
            </div>
        </header>

        <main class="container-fluid p-3 p-md-4">
            <%- body %>
        </main>
    </div>
</div>

<script>
    window.meta = <%- JSON.stringify(user || {}) %>;
</script>
