<% const permissions = user?.permissions || [];

const can = permission => permissions.includes(permission);

const canSeeAll = user?.scope?.canReadAll || false;

const shouldShowIcons = typeof showIcons !== 'undefined' ? showIcons : true;

const items = [
    {
        content: 'Almacén',
        icon: 'fa-solid fa-boxes-stacked',
        href: '/materiales',
        isActive: currentRoute === '/materiales',
        isVisible: can('materials:read')
    },
    {
        content: 'Mermas',
        icon: 'fa-solid fa-recycle',
        href: '/mermas',
        isActive: currentRoute === '/mermas',
        isVisible: can('wastes:page-view')
    },
    {
        content: 'Compras',
        icon: 'fa-solid fa-cart-shopping',
        href: '/compras',
        isActive: currentRoute === '/compras',
        isVisible: can('goods:receipts-page-view')
    },
    {
        content: 'Salidas de almacén',
        icon: 'fa-solid fa-truck-ramp-box',
        href: '/salidas-almacen',
        isActive: currentRoute === '/salidas-almacen',
        isVisible: can('goods:issues-page-view')
    },
    {
        content: 'Movimientos',
        icon: 'fa-solid fa-arrow-right-arrow-left',
        href: '/movimientos',
        isActive: currentRoute === '/movimientos',
        isVisible: can('movements:read')
    },
    {
        content: 'Usuarios',
        icon: 'fa-solid fa-users-gear',
        href: '/usuarios-sistemas',
        isActive: currentRoute === '/usuarios-sistemas',
        isVisible: can('users:manage')
    },
    {
        content: 'Perfiles',
        icon: 'fa-solid fa-id-badge',
        href: '/perfiles',
        isActive: currentRoute === '/perfiles',
        isVisible: can('profiles:page-view')
    },
    {
        content: 'Clientes',
        icon: 'fa-solid fa-handshake',
        href: '/clientes',
        isActive: currentRoute === '/clientes',
        isVisible: can('clients:page-view')
    },
    {
        content: 'Proveedores',
        icon: 'fa-solid fa-warehouse',
        href: '/proveedores',
        isActive: currentRoute === '/proveedores',
        isVisible: can('suppliers:page-view')
    }
].filter(item => {
    if (canSeeAll) return true;

    return item.isVisible;
}).map(item => ({
    ...item,
    class: `nav-link ${ shouldShowIcons ? 'app-nav-link--icon' : '' } ${ item.isActive ? 'active' : ''}`
})); %>

<ul class="<%= listClass %>">
    <% items.forEach(item => { %>
        <li class="nav-item py-1">
            <a class="<%= item.class %>" href="<%= item.href %>"
                <%= item.isActive ? 'aria-current="page"' : '' %>
            >
                <% if (shouldShowIcons && item.icon) { %>
                    <span class="app-nav-link__icon" aria-hidden="true">
                        <i class="<%= item.icon %>"></i>
                    </span>
                <% } %>
                <span><%- item.content %></span>
            </a>
        </li>
    <% }); %>
</ul>
