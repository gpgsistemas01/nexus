<% const permissions = user?.permissions || [];


const canSeeAll = user?.scope?.canReadAll || false;

const shouldShowIcons = typeof showIcons !== 'undefined' ? showIcons : true;
const shouldShowLabels = typeof showLabels !== 'undefined' ? showLabels : true;

const createNavLink = ({ content, icon, href, permission }) => ({
    content,
    icon,
    href,
    isActive: currentRoute === href,
    isVisible: permissions.includes(permission)
});

const createNavGroup = ({ content, icon, children }) => ({
    content,
    icon,
    children
});

const items = [
    createNavGroup({
        content: 'Almacén',
        icon: 'fa-solid fa-boxes-stacked',
        children: [
            createNavLink({ content: 'Materiales', icon: 'fa-solid fa-boxes-stacked', href: '/materiales', permission: 'materials:read' }),
            createNavLink({ content: 'Mermas', icon: 'fa-solid fa-recycle', href: '/mermas', permission: 'wastes:page-view' })
        ]
    }),
    createNavLink({ content: 'Compras', icon: 'fa-solid fa-cart-shopping', href: '/compras', permission: 'goods:receipts-page-view' }),
    createNavGroup({
        content: 'Salidas',
        icon: 'fa-solid fa-arrow-up-from-bracket',
        children: [
            createNavLink({ content: 'De almacén', icon: 'fa-solid fa-truck-ramp-box', href: '/salidas-almacen', permission: 'goods:issues-page-view' }),
            createNavLink({ content: 'De merma', icon: 'fa-solid fa-recycle', href: '/salidas-merma', permission: 'wastes:page-view' })
        ]
    }),
    createNavLink({ content: 'Movimientos', icon: 'fa-solid fa-arrow-right-arrow-left', href: '/movimientos', permission: 'movements:read' }),
    createNavLink({ content: 'Usuarios', icon: 'fa-solid fa-users-gear', href: '/usuarios-sistemas', permission: 'users:manage' }),
    createNavLink({ content: 'Personas', icon: 'fa-solid fa-id-badge', href: '/personas', permission: 'persons:page-view' }),
    createNavLink({ content: 'Clientes', icon: 'fa-solid fa-handshake', href: '/clientes', permission: 'clients:page-view' }),
    createNavLink({ content: 'Proveedores', icon: 'fa-solid fa-warehouse', href: '/proveedores', permission: 'suppliers:page-view' })
].map(item => {
    const visibleChildren = (item.children || []).filter(child => {
        if (canSeeAll) return true;

        return child.isVisible;
    });

    return {
        ...item,
        children: visibleChildren,
        isActive: item.isActive || visibleChildren.some(child => child.isActive),
        isVisible: item.children ? visibleChildren.length > 0 : item.isVisible
    };
}).filter(item => {
    if (canSeeAll) return true;

    return item.isVisible;
}).map((item, index) => ({
    ...item,
    submenuId: `appNavSubmenu${ index }`,
    class: `nav-link ${ shouldShowIcons ? 'app-nav-link--icon' : '' } ${ !shouldShowLabels ? 'app-nav-link--icon-only' : '' } ${ item.isActive ? 'active' : ''}`,
    children: (item.children || []).map(child => ({
        ...child,
        class: `nav-link app-nav-link--child ${ shouldShowIcons ? 'app-nav-link--icon' : '' } ${ !shouldShowLabels ? 'app-nav-link--icon-only' : '' } ${ child.isActive ? 'active' : ''}`
    }))
})); %>

<ul class="<%= listClass %> <%= !shouldShowLabels ? 'app-nav-list--icon-only' : '' %>">
    <% items.forEach(item => { %>
        <li class="nav-item py-1">
            <% if (item.children.length) { %>
                <button
                    type="button"
                    class="<%= item.class %> app-nav-link--section app-nav-submenu-toggle"
                    data-mdb-collapse-init
                    data-mdb-target="#<%= item.submenuId %>"
                    aria-expanded="<%= item.isActive ? 'true' : 'false' %>"
                    aria-controls="<%= item.submenuId %>"
                    <%= item.isActive ? 'aria-current="true"' : '' %>
                    <%- include('./navTooltipAttrs', { enabled: !shouldShowLabels, label: item.content }) %>
                >
                    <% if (shouldShowIcons && item.icon) { %>
                        <span class="app-nav-link__icon" aria-hidden="true">
                            <i class="<%= item.icon %>"></i>
                        </span>
                    <% } %>
                    <% if (shouldShowLabels) { %>
                        <span class="app-nav-link__label"><%- item.content %></span>
                    <% } %>
                    <span class="app-nav-submenu-toggle__icon" aria-hidden="true">
                        <i class="fa-solid fa-chevron-down"></i>
                    </span>
                </button>

                <ul id="<%= item.submenuId %>" class="navbar-nav flex-column collapse <%= item.isActive ? 'show' : '' %> app-nav-submenu">
                    <% item.children.forEach(child => { %>
                        <li class="nav-item py-1">
                            <a class="<%= child.class %>" href="<%= child.href %>"
                                <%= child.isActive ? 'aria-current="page"' : '' %>
                                <%- include('./navTooltipAttrs', { enabled: !shouldShowLabels, label: child.content }) %>
                            >
                                <% if (shouldShowIcons && child.icon) { %>
                                    <span class="app-nav-link__icon" aria-hidden="true">
                                        <i class="<%= child.icon %>"></i>
                                    </span>
                                <% } %>
                                <% if (shouldShowLabels) { %>
                                    <span class="app-nav-link__label"><%- child.content %></span>
                                <% } %>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <a class="<%= item.class %>" href="<%= item.href %>"
                    <%= item.isActive ? 'aria-current="page"' : '' %>
                    <%- include('./navTooltipAttrs', { enabled: !shouldShowLabels, label: item.content }) %>
                >
                    <% if (shouldShowIcons && item.icon) { %>
                        <span class="app-nav-link__icon" aria-hidden="true">
                            <i class="<%= item.icon %>"></i>
                        </span>
                    <% } %>
                    <% if (shouldShowLabels) { %>
                        <span class="app-nav-link__label"><%- item.content %></span>
                    <% } %>
                </a>
                <% } %>
        </li>
    <% }); %>
</ul>
