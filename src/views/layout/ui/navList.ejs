<% const permissions = user?.permissions || [];


const canSeeAll = user?.scope?.canReadAll || false;

const shouldShowIcons = typeof showIcons !== 'undefined' ? showIcons : true;

const items = [
    {
        content: 'Almacén',
        icon: 'fa-solid fa-boxes-stacked',
        href: '/materiales',
        isActive: currentRoute === '/materiales',
        isVisible: permissions.includes('materials:read')
    },
    {
        content: 'Mermas',
        icon: 'fa-solid fa-recycle',
        href: '/mermas',
        isActive: currentRoute === '/mermas',
        isVisible: permissions.includes('wastes:page-view')
    },
    {
        content: 'Compras',
        icon: 'fa-solid fa-cart-shopping',
        href: '/compras',
        isActive: currentRoute === '/compras',
        isVisible: permissions.includes('goods:receipts-page-view')
    },
    {
        content: 'Salidas',
        icon: 'fa-solid fa-arrow-up-from-bracket',
        children: [
            {
                content: 'Salidas de almacén',
                icon: 'fa-solid fa-truck-ramp-box',
                href: '/salidas-almacen',
                isActive: currentRoute === '/salidas-almacen',
                isVisible: permissions.includes('goods:issues-page-view')
            },
            {
                content: 'Salidas de merma',
                icon: 'fa-solid fa-recycle',
                href: '/salidas-merma',
                isActive: currentRoute === '/salidas-merma',
                isVisible: permissions.includes('wastes:page-view')
            }
        ]
    },
    {
        content: 'Movimientos',
        icon: 'fa-solid fa-arrow-right-arrow-left',
        href: '/movimientos',
        isActive: currentRoute === '/movimientos',
        isVisible: permissions.includes('movements:read')
    },
    {
        content: 'Usuarios',
        icon: 'fa-solid fa-users-gear',
        href: '/usuarios-sistemas',
        isActive: currentRoute === '/usuarios-sistemas',
        isVisible: permissions.includes('users:manage')
    },
    {
        content: 'Personas',
        icon: 'fa-solid fa-id-badge',
        href: '/personas',
        isActive: currentRoute === '/personas',
        isVisible: permissions.includes('persons:page-view')
    },
    {
        content: 'Clientes',
        icon: 'fa-solid fa-handshake',
        href: '/clientes',
        isActive: currentRoute === '/clientes',
        isVisible: permissions.includes('clients:page-view')
    },
    {
        content: 'Proveedores',
        icon: 'fa-solid fa-warehouse',
        href: '/proveedores',
        isActive: currentRoute === '/proveedores',
        isVisible: permissions.includes('suppliers:page-view')
    }
].map(item => {
    const visibleChildren = (item.children || []).filter(child => {
        if (canSeeAll) return true;

        return child.isVisible;
    });

    return {
        ...item,
        children: visibleChildren,
        isActive: item.isActive || visibleChildren.some(child => child.isActive),
        isVisible: item.children ? visibleChildren.length > 0 : item.isVisible
    };
}).filter(item => {
    if (canSeeAll) return true;

    return item.isVisible;
}).map(item => ({
    ...item,
    class: `nav-link ${ shouldShowIcons ? 'app-nav-link--icon' : '' } ${ item.isActive ? 'active' : ''}`,
    children: (item.children || []).map(child => ({
        ...child,
        class: `nav-link app-nav-link--child ${ shouldShowIcons ? 'app-nav-link--icon' : '' } ${ child.isActive ? 'active' : ''}`
    }))
})); %>

<ul class="<%= listClass %>">
    <% items.forEach(item => { %>
        <li class="nav-item py-1">
            <% if (item.children.length) { %>
                <span class="<%= item.class %> app-nav-link--section" <%= item.isActive ? 'aria-current="true"' : '' %>>
                    <% if (shouldShowIcons && item.icon) { %>
                        <span class="app-nav-link__icon" aria-hidden="true">
                            <i class="<%= item.icon %>"></i>
                        </span>
                    <% } %>
                    <span class="app-nav-link__label"><%- item.content %></span>
                </span>

                <ul class="navbar-nav app-nav-submenu">
                    <% item.children.forEach(child => { %>
                        <li class="nav-item py-1">
                            <a class="<%= child.class %>" href="<%= child.href %>"
                                <%= child.isActive ? 'aria-current="page"' : '' %>
                            >
                                <% if (shouldShowIcons && child.icon) { %>
                                    <span class="app-nav-link__icon" aria-hidden="true">
                                        <i class="<%= child.icon %>"></i>
                                    </span>
                                <% } %>
                                <span class="app-nav-link__label"><%- child.content %></span>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <a class="<%= item.class %>" href="<%= item.href %>"
                    <%= item.isActive ? 'aria-current="page"' : '' %>
                >
                    <% if (shouldShowIcons && item.icon) { %>
                        <span class="app-nav-link__icon" aria-hidden="true">
                            <i class="<%= item.icon %>"></i>
                        </span>
                    <% } %>
                    <span class="app-nav-link__label"><%- item.content %></span>
                </a>
                <% } %>
        </li>
    <% }); %>
</ul>
