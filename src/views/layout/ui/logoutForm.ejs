<% const formClass = typeof className !== 'undefined' ? className : 'd-inline'; %>
<form method="post" action="/cerrar-sesion" class="<%= formClass %>">
    <button type="submit" class="<%= buttonClass %>" aria-label="Cerrar sesión">
        <span class="app-logout-btn__icon" aria-hidden="true">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </span>
        <span class="app-logout-btn__label">Salir</span>
    </button>
</form>
