<% const form = {
    id: 'materialForm',
    canApprove: false,
    invoice: false,
    sections: [
        {
            title: 'Datos del material',
            class: 'material-data-section',
            groups: [
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'nameInput',
                            type: 'text',
                            name: 'name',
                            label: 'Nombre',
                            col: '12'
                        }
                    ]
                },
                {
                    type: 'selects',
                    items: [
                        {
                            id: 'materialSupplierInput',
                            name: 'supplierId',
                            class: 'supplier-select',
                            col: 'col-12'
                        },
                        {
                            id: 'presentationInput',
                            name: 'presentationId',
                            class: 'presentation-select',
                            col: 'col-12 col-md-6'
                        },
                        {
                            id: 'unitMeasureInput',
                            name: 'unitMeasureId',
                            class: 'unit-measure-select',
                            col: 'col-12 col-md-6'
                        }
                    ]
                }
            ]
        },
        {
            title: 'Medidas del material',
            class: 'material-measurements-section',
            groups: [
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'baseInput',
                            type: 'number',
                            name: 'base',
                            label: 'Base',
                            attrs: {
                                'min': '0.01'
                            },
                            col: '6'
                        },
                        {
                            id: 'heightInput',
                            type: 'number',
                            name: 'height',
                            label: 'Altura',
                            attrs: {
                                'min': '0.01'
                            },
                            col: '6'
                        }
                    ]
                }
            ]
        },
        {
            title: 'Inventario del material',
            groups: [
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'minStockInput',
                            type: 'number',
                            name: 'minStock',
                            label: 'Stock mínimo',
                            attrs: { min: '0' },
                            col: '6'
                        },
                        {
                            id: 'maxUnitCostInput',
                            type: 'number',
                            name: 'maxUnitCost',
                            label: 'Costo máximo',
                            attrs: { min: '0', step: 'any', required: true },
                            col: '6'
                        }
                    ]
                },
                {
                    type: 'checkboxes',
                    items: [{ id: 'isActiveInput', type: 'checkbox', name: 'isActive', label: 'Activo', isChecked: true }]
                }
            ]
        },
        {
            title: 'Existencias y observaciones',
            class: 'stock-data-section',
            groups: [
                {
                    type: 'selects',
                    items: [
                        {
                            id: 'reasonInput',
                            name: 'reasonId',
                            class: 'reason-select',
                            col: 'col-6'
                        }
                    ]
                },
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'quantityInput',
                            type: 'number',
                            name: 'newStock',
                            label: 'Nueva cantidad',
                            attrs: {
                                'min': '0'
                            },
                            col: '6'
                        }
                    ]
                },
                {
                    type: 'textarea',
                    input: {
                        id: 'observationsInput',
                        name: 'observations',
                        label: 'Observaciones'
                    }
                }
            ]
        }
    ]
} %>

<%- include('../../../shared/layout/modal', { modalId: 'materialModal', form }) %>
