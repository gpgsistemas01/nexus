<% const form = {
    id: 'wasteForm',
    canApprove: false,
    invoice: false,
    sections: [
        {
            title: 'Datos de la merma',
            class: 'waste-data-section',
            groups: [
                {
                    type: 'selects',
                    items: [
                        {
                            id: 'supplierInput',
                            name: 'supplierId',
                            class: 'supplier-select',
                            label: 'Proveedor',
                            col: 'col-12'
                        }
                    ]
                },
                {
                    type: 'selects',
                    items: [
                        {
                            id: 'materialInput',
                            name: 'materialId',
                            class: 'material-select',
                            label: 'Material de referencia del proveedor',
                            col: 'col-12 waste-material-template-field'
                        }
                    ]
                },
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'wasteNameDisplayValue',
                            type: 'text',
                            name: 'name',
                            label: 'Nombre de la merma',
                            value: '',
                            attrs: {
                                maxlength: '200'
                            },
                            col: '6'
                        }
                    ]
                },
                {
                    type: 'html',
                    col: 'col-12 col-md-6',
                    content: include('../../../shared/forms/informativeValue', {
                        value: {
                            id: 'wastePresentationDisplayValue',
                            label: 'Presentación'
                        }
                    })
                },
                {
                    type: 'html',
                    col: 'col-12 col-md-6',
                    content: include('../../../shared/forms/informativeValue', {
                        value: {
                            id: 'wasteUnitMeasureDisplayValue',
                            label: 'Unidad de medida'
                        }
                    })
                },
                {
                    type: 'html',
                    col: 'col-12 waste-roll-reference',
                    content: include('../../../shared/forms/informativeValue', {
                        value: { id: 'wasteConeReferenceInfo', label: 'Datos del material seleccionado' }
                    })
                },
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'baseInput',
                            type: 'number',
                            name: 'base',
                            label: 'Base de la merma (m)',
                            value: '',
                            attrs: {
                                min: '0.01'
                            },
                            col: '6'
                        },
                        {
                            id: 'heightInput',
                            type: 'number',
                            name: 'height',
                            label: 'Altura de la merma (m)',
                            value: '',
                            attrs: {
                                min: '0.01'
                            },
                            col: '6'
                        },
                        {
                            id: 'minStockInput',
                            type: 'number',
                            name: 'minStock',
                            label: 'Stock mínimo',
                            value: '',
                            attrs: {
                                min: '0.01'
                            },
                            col: '6'
                        },
                        {
                            id: 'maxUnitCostInput',
                            type: 'number',
                            name: 'maxUnitCost',
                            label: 'Costo máximo unitario',
                            value: '',
                            attrs: {
                                min: '0',
                                step: '0.01'
                            },
                            col: '6'
                        }
                    ],
                },
                {
                    type: 'checkboxes',
                    items: [
                        {
                            id: 'isActiveInput',
                            type: 'checkbox',
                            name: 'isActive',
                            label: 'Activo',
                            isChecked: true
                        }
                    ]
                }
            ]
        },
        {
            title: 'Pesos por unidad (kg)',
            class: 'waste-weight-fields',
            groups: [
                {
                    type: 'html',
                    col: 'col-12',
                    content: include('../../../shared/inventory/rollWeightFields', { fields: [
                        { col: 'col-12 col-md-4', id: 'coneWeightKgInput', name: 'coneWeightKg', label: 'Peso del cono por unidad (kg)', allowZero: true },
                        { col: 'col-12 col-md-4', id: 'totalWeightKgInput', name: 'totalWeightKg', label: 'Peso total por unidad con cono (kg)' },
                        { col: 'col-12 col-md-4', id: 'weightKgInput', name: 'weightKg', label: 'Peso neto por unidad de merma (kg)', readOnly: true }
                    ] })
                }
            ]
        },
        {
            title: 'Datos de ajuste',
            class: 'stock-data-section',
            groups: [
                {
                    type: 'selects',
                    items: [
                        {
                            id: 'reasonInput',
                            name: 'reasonId',
                            class: 'reason-select',
                            col: 'col-6'
                        }
                    ]
                },
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'newStockInput',
                            type: 'number',
                            name: 'newStock',
                            label: 'Nuevo stock',
                            value: '',
                            attrs: {
                                min: '0'
                            },
                            col: '6'
                        }
                    ]
                },
                {
                    type: 'textarea',
                    input: {
                        id: 'observationsInput',
                        name: 'observations',
                        label: 'Observaciones'
                    }
                }
            ]
        }
    ]
}; %>

<%- include('../../../shared/tables/tableFilters', {
    selectInputs: [
        {
            id: 'supplierFilter',
            label: 'Proveedor:',
            col: 'col-12 col-md-6 col-lg-4'
        }
    ],
    dateInputs: []
}) %>

<%- include('../../../shared/tables/mainTable', { title: 'Mermas' }) %>

<%- include('../../../shared/layout/modal', { modalId: 'wasteModal', form }) %>

<%- include('wasteStockAdditionModal') %>

<script type="module" src="/js/pages/warehouse/wastes/wastesPage.js"></script>

<%- contentFor('title') %>
Mermas
<%- contentFor('layoutType') %>
site