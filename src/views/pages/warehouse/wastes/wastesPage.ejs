<% const form = {
    id: 'wasteForm',
    canApprove: false,
    invoice: false,
    sections: [
        {
            title: 'Material de origen',
            class: 'waste-data-section',
            groups: [
                {
                    type: 'selects',
                    items: [
                        {
                            id: 'supplierInput',
                            name: 'supplierId',
                            class: 'supplier-select',
                            label: 'Proveedor',
                            col: 'col-12 col-md-6'
                        }
                    ]
                },
                {
                    type: 'selects',
                    items: [
                        {
                            id: 'materialInput',
                            name: 'materialId',
                            class: 'material-select',
                            label: 'Material de referencia del proveedor',
                            col: 'col-12 col-md-6 waste-material-template-field'
                        }
                    ]
                }
            ]
        },
        {
            title: 'Datos de la merma',
            groups: [
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'wasteNameDisplayValue',
                            type: 'text',
                            name: 'name',
                            label: 'Nombre de la merma',
                            value: '',
                            attrs: {
                                maxlength: '200'
                            },
                            col: '12'
                        },
                        {
                            id: 'wastePresentationDisplayValue',
                            type: 'text',
                            name: 'presentationDisplay',
                            label: 'Presentación',
                            value: '',
                            attrs: { disabled: true },
                            col: '6'
                        },
                        {
                            id: 'wasteUnitMeasureDisplayValue',
                            type: 'text',
                            name: 'unitMeasureDisplay',
                            label: 'Unidad de medida',
                            value: '',
                            attrs: { disabled: true },
                            col: '6'
                        }
                    ]
                }
            ]
        },
        {
            title: 'Referencia histórica',
            description: 'Datos conservados del registro anterior.',
            class: 'waste-sample-fields d-none',
            groups: [{
                type: 'inputs',
                items: [
                    { id: 'sampleLengthInput', name: 'sampleLengthM', type: 'number', label: 'Largo de referencia (m)', value: '', attrs: { min: '0.000001', step: 'any' }, col: '6' },
                    { id: 'sampleNetWeightInput', name: 'sampleNetWeightKg', type: 'number', label: 'Peso neto de referencia (kg)', value: '', attrs: { min: '0.000001', step: 'any' }, col: '6' }
                ]
            }]
        },
        {
            title: 'Rollo completo (muestra)',
            description: 'El largo proviene del material. Se utiliza el mismo cono de la merma.',
            class: 'waste-roll-reference-fields d-none',
            groups: [{
                type: 'html',
                col: 'col-12',
                content: include('../../../shared/inventory/rollWeightFields', { fields: [
                    { col: 'col-12', id: 'referenceRollTotalWeightKgInput', name: 'referenceRollTotalWeightKg', label: 'Peso del rollo completo con cono (kg)' }
                ] })
            }]
        },
        {
            title: 'Pesos de la merma',
            description: 'Pesos por unidad de merma.',
            class: 'waste-weight-fields d-none',
            groups: [{
                type: 'html',
                col: 'col-12',
                content: include('../../../shared/inventory/rollWeightFields', { fields: [
                    { col: 'col-12 col-lg-4', id: 'coneWeightKgInput', name: 'coneWeightKg', label: 'Peso del cono de la merma (kg)', allowZero: true },
                    { col: 'col-12 col-lg-4', id: 'totalWeightKgInput', name: 'totalWeightKg', label: 'Peso de la merma con cono (kg)' },
                    { col: 'col-12 col-lg-4', id: 'weightKgInput', name: 'weightKg', label: 'Peso neto de la merma (kg)', readOnly: true }
                ] })
            }]
        },
        {
            title: 'Medidas de la merma',
            groups: [
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'baseInput',
                            type: 'number',
                            name: 'base',
                            label: 'Base de la merma (m)',
                            value: '',
                            attrs: {
                                min: '0.01'
                            },
                            col: '6'
                        },
                        {
                            id: 'heightInput',
                            type: 'number',
                            name: 'height',
                            label: 'Altura de la merma (m)',
                            value: '',
                            attrs: {
                                min: '0.01'
                            },
                            col: '6'
                        }
                    ]
                }
            ]
        },
        {
            title: 'Inventario de la merma',
            groups: [
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'minStockInput',
                            type: 'number',
                            name: 'minStock',
                            label: 'Stock mínimo',
                            value: '',
                            attrs: {
                                min: '0'
                            },
                            col: '6'
                        },
                        {
                            id: 'maxUnitCostInput',
                            type: 'number',
                            name: 'maxUnitCost',
                            label: 'Costo máximo unitario',
                            value: '',
                            attrs: {
                                min: '0',
                                step: '0.01'
                            },
                            col: '6'
                        }
                    ],
                },
                {
                    type: 'checkboxes',
                    items: [
                        {
                            id: 'isActiveInput',
                            type: 'checkbox',
                            name: 'isActive',
                            label: 'Activo',
                            isChecked: true
                        }
                    ]
                }
            ]
        },
        {
            title: 'Existencias y observaciones',
            class: 'stock-data-section',
            groups: [
                {
                    type: 'selects',
                    items: [
                        {
                            id: 'reasonInput',
                            name: 'reasonId',
                            class: 'reason-select',
                            col: 'col-6'
                        }
                    ]
                },
                {
                    type: 'inputs',
                    items: [
                        {
                            id: 'initialQuantityInput',
                            type: 'number',
                            name: 'initialQuantity',
                            label: 'Cantidad inicial',
                            value: '',
                            attrs: {
                                min: '0'
                            },
                            col: '6'
                        },
                        {
                            id: 'newStockInput',
                            type: 'number',
                            name: 'newStock',
                            label: 'Nuevo stock',
                            value: '',
                            attrs: {
                                min: '0'
                            },
                            col: '6'
                        }
                    ]
                },
                {
                    type: 'textarea',
                    input: {
                        id: 'observationsInput',
                        name: 'observations',
                        label: 'Observaciones'
                    }
                }
            ]
        }
    ]
}; %>

<%- include('../../../shared/tables/tableFilters', {
    selectInputs: [
        {
            id: 'supplierFilter',
            label: 'Proveedor:',
            col: 'col-12 col-md-6 col-lg-4'
        }
    ],
    dateInputs: []
}) %>

<%- include('../../../shared/tables/mainTable', { title: 'Mermas' }) %>

<%- include('../../../shared/layout/modal', { modalId: 'wasteModal', form }) %>

<%- include('wasteStockAdditionModal') %>

