<% const form = {
    id: 'wasteIssueForm',
    selects: [
        { id: 'clientInput', name: 'clientId', class: 'client-select', col: 'col-6' },
        { id: 'advisorInput', name: 'advisorId', class: 'advisor-select', col: 'col-6' },
        { id: 'departmentInput', name: 'departmentId', class: 'department-select', col: 'col-6' },
        { id: 'requesterInput', name: 'requesterId', class: 'request-select', col: 'col-6' }
    ],
    inputs: [
        {
            id: 'projectNumberInput',
            name: 'projectNumber',
            type: 'text',
            label: 'Número de proyecto',
            col: '6'
        },
        {
            id: 'wasteIssueDate',
            name: 'requestDate',
            type: 'text',
            class: 'js-flatpickr-datetime',
            label: 'Fecha y hora de solicitud',
            col: '6'
        }
    ],
    textArea: {
        id: 'wasteIssueObservations',
        name: 'observations',
        label: 'Observaciones'
    },
    table: {
        errorName: 'details',
        includeSummary: false,
        select: {
            id: 'wasteIssueWaste',
            name: 'wasteId',
            class: 'waste-select',
            col: 'col-12'
        },
        inputs: [
            {
                id: 'wasteIssueQuantity',
                name: 'quantity',
                type: 'number',
                label: 'Cantidad',
                attrs: { min: '0.01', step: '0.01' },
                col: 'col-12 col-md-6 col-lg-7'
            }
        ]
    }
} %>

<%- include('../../../shared/mainTable', { title: 'Salidas de merma' }) %>
<%- include('../../../shared/modal', {
    modalId: 'wasteIssueModal',
    modalTitle: 'Registrar salida de merma',
    form
}) %>

<%- include('../../../shared/issues/issueReturnModal', { returnPrefix: 'wasteIssue' }) %>

<script type="module" src="/js/pages/warehouse/wasteIssues/wasteIssuesPage.js"></script>

