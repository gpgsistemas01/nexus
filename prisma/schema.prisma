generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @unique @db.VarChar(50)
  personAccesses       PersonRoleDepartment[]
  accesses             UserRoleDepartment[]
  purchaseRequisitions PurchaseRequisition[]
  goodsIssues          GoodsIssue[]
  notifications        Notification[]
}

model Role {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String                 @unique @db.VarChar(50)
  accesses       UserRoleDepartment[]
  personAccesses PersonRoleDepartment[]
}

model User {
  id                            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId                      String?                @db.Uuid
  name                          String                 @unique @db.VarChar(50)
  password                      String                 @db.VarChar(100)
  isActive                      Boolean                @default(true)
  person                        Person?                @relation(fields: [personId], references: [id])
  accesses                      UserRoleDepartment[]
  notifications                 Notification[]
  createrStockAdjustment        StockAdjustment[]      @relation("CreatedStockAdjustments")
  approverStockAdjustment       StockAdjustment[]      @relation("ApprovedStockAdjustments")
  goodsIssueReturns             GoodsIssueReturn[]
  createdWasteStockAdjustments  WasteStockAdjustment[] @relation("CreatedWasteStockAdjustments")
  approvedWasteStockAdjustments WasteStockAdjustment[] @relation("ApprovedWasteStockAdjustments")
}

model UserRoleDepartment {
  userId       String @db.Uuid
  roleId       String @db.Uuid
  departmentId String @db.Uuid

  user       User       @relation(fields: [userId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([userId, roleId, departmentId])
}

/// Persona que participa en los procesos del negocio. `Person` identifica el papel
/// persistido; la cuenta `User` conserva la trazabilidad del actor que ejecuta acciones.
/// El UUID y sus claves foráneas mantienen el seguimiento histórico de la persona.
model Person {
  id                            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName                      String                 @db.VarChar(255)
  isActive                      Boolean                @default(true)
  goodsReceipts                 GoodsReceipt[]
  accesses                      PersonRoleDepartment[]
  users                         User[]
  approverPurchaseRequisitions  PurchaseRequisition[]  @relation("ApproverRelation")
  requesterPurchaseRequisitions PurchaseRequisition[]  @relation("RequesterRelation")
  approverGoodsIssues           GoodsIssue[]           @relation("ApproverGoodsIssueRelation")
  requesterGoodsIssues          GoodsIssue[]           @relation("RequesterGoodsIssueRelation")
  warehouseStaffGoodsIssues     GoodsIssue[]           @relation("WarehouseStaffGoodsIssueRelation")
  deliveredPurchaseRequisitions PurchaseRequisition[]  @relation("DeliveredByRelation")
  clients                       Client[]
  goodsIssues                   GoodsIssue[]
}

/// Accesos por área y rol asignados a una persona del negocio (`Person`).
model PersonRoleDepartment {
  departmentId String @db.Uuid
  personId     String @db.Uuid
  roleId       String @db.Uuid

  department Department @relation(fields: [departmentId], references: [id])
  person     Person     @relation(fields: [personId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([personId, roleId, departmentId])
}

model Status {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                @unique
  goodsReceipts        GoodsReceipt[]
  purchaseRequisitions PurchaseRequisition[]
  goodsIssues          GoodsIssue[]
}

model Material {
  id                                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                               String                      @db.VarChar(200)
  sku                                String?                     @unique @db.VarChar(200)
  presentationId                     String                      @db.Uuid
  unitMeasureId                      String                      @db.Uuid
  isActive                           Boolean                     @default(true)
  minStock                           Decimal                     @default(0) @db.Decimal(10, 2)
  base                               Decimal?                    @db.Decimal(10, 2)
  height                             Decimal?                    @db.Decimal(10, 2)
  presentation                       Presentation                @relation(fields: [presentationId], references: [id])
  unitMeasure                        UnitMeasure                 @relation(fields: [unitMeasureId], references: [id])
  goodsIssueDetails                  GoodsIssueDetail[]
  goodsReceiptDetails                GoodsReceiptDetail[]
  previousGoodsReceiptDetailChanges  GoodsReceiptDetailChange[]  @relation("PreviousGoodsReceiptDetailChangeMaterial")
  correctedGoodsReceiptDetailChanges GoodsReceiptDetailChange[]  @relation("CorrectedGoodsReceiptDetailChangeMaterial")
  purchaseRequisitionsDetails        PurchaseRequisitionDetail[]
  movementDetails                    MovementDetail[]
  supplierMaterials                  SupplierMaterial[]
  stockAdjustmentDetails             StockAdjustmentDetail[]
}

model UnitMeasure {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @db.VarChar(20)
  symbol            String             @db.VarChar(10)
  goodsIssueDetails GoodsIssueDetail[]
  materials         Material[]

  @@unique([name, symbol])
}

model Presentation {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique @db.VarChar(50)
  goodsIssueDetail GoodsIssueDetail[]
  materials        Material[]
}

model Supplier {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeNumber             Int
  code                   String                  @unique @db.VarChar(10)
  legalName              String                  @db.VarChar(200)
  tradeName              String                  @db.VarChar(100)
  isActive               Boolean                 @default(true)
  goodsReceipts          GoodsReceipt[]
  goodsIssueDetails      GoodsIssueDetail[]
  materials              SupplierMaterial[]
  movementDetails        MovementDetail[]
  stockAdjustmentDetails StockAdjustmentDetail[]
}

model SupplierMaterial {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maxUnitCost       Decimal? @db.Decimal(10, 2)
  sku               String?  @db.VarChar(50)
  currentStock      Decimal  @default(0) @db.Decimal(10, 2)
  convertedQuantity Decimal  @default(0) @db.Decimal(10, 2)
  supplierId        String   @db.Uuid
  materialId        String   @db.Uuid
  supplier          Supplier @relation(fields: [supplierId], references: [id])
  material          Material @relation(fields: [materialId], references: [id])
  wastes            Waste[]

  @@unique([supplierId, materialId])
  @@index([supplierId])
  @@index([materialId])
}

model Waste {
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierMaterialId     String                       @db.Uuid
  isActive               Boolean                      @default(true)
  minStock               Decimal                      @default(0) @db.Decimal(10, 2)
  base                   Decimal?                     @db.Decimal(10, 2)
  height                 Decimal?                     @db.Decimal(10, 2)
  currentStock           Decimal                      @default(0) @db.Decimal(10, 2)
  convertedQuantity      Decimal                      @default(0) @db.Decimal(10, 2)
  supplierMaterial       SupplierMaterial             @relation(fields: [supplierMaterialId], references: [id])
  stockAdjustmentDetails WasteStockAdjustmentDetail[]
  movementDetails        WasteMovementDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierMaterialId, base, height])
  @@index([supplierMaterialId])
}

model WasteStockAdjustment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  referenceNumber String @unique @db.VarChar(50)

  type         StockAdjustmentType
  reasonId     String              @db.Uuid
  observations String?             @db.VarChar(500)

  status AdjustmentStatus @default(PENDING)

  createdById     String  @db.Uuid
  approvedById    String? @db.Uuid
  wasteMovementId String? @unique @db.Uuid

  reason     StockAdjustmentReason @relation(fields: [reasonId], references: [id])
  createdBy  User                  @relation("CreatedWasteStockAdjustments", fields: [createdById], references: [id])
  approvedBy User?                 @relation("ApprovedWasteStockAdjustments", fields: [approvedById], references: [id])

  movement WasteMovement?               @relation(fields: [wasteMovementId], references: [id], onDelete: SetNull)
  details  WasteStockAdjustmentDetail[]

  appliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reasonId])
  @@index([createdById])
  @@index([approvedById])
}

model WasteStockAdjustmentDetail {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  wasteStockAdjustmentId String @db.Uuid
  wasteId                String @db.Uuid

  materialId   String @db.Uuid
  supplierId   String @db.Uuid
  materialName String @db.VarChar(200)
  supplierName String @db.VarChar(200)
  wasteBase    Decimal? @db.Decimal(10, 2)
  wasteHeight  Decimal? @db.Decimal(10, 2)

  previousStock Decimal @db.Decimal(10, 2)
  newStock      Decimal @db.Decimal(10, 2)
  difference    Decimal @db.Decimal(10, 2)

  previousConvertedQuantity Decimal @db.Decimal(10, 2)
  newConvertedQuantity      Decimal @db.Decimal(10, 2)
  convertedDifference       Decimal @db.Decimal(10, 2)

  wasteStockAdjustment WasteStockAdjustment  @relation(fields: [wasteStockAdjustmentId], references: [id], onDelete: Cascade)
  waste                Waste                 @relation(fields: [wasteId], references: [id])
  movementDetails      WasteMovementDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wasteStockAdjustmentId])
  @@index([wasteId])
  @@index([materialId])
  @@index([supplierId])
}

model WasteMovement {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNumber      String?               @unique @db.VarChar(50)
  type                 InventoryMovementType
  details              WasteMovementDetail[]
  date                 DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  wasteStockAdjustment WasteStockAdjustment?
}

model WasteMovementDetail {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantity                     Decimal  @db.Decimal(10, 2)
  newStock                     Decimal? @db.Decimal(10, 2)
  previousStock                Decimal? @db.Decimal(10, 2)
  wasteId                      String   @db.Uuid
  wasteStockAdjustmentDetailId String?  @db.Uuid
  movementId                   String   @db.Uuid

  waste                      Waste                       @relation(fields: [wasteId], references: [id])
  wasteStockAdjustmentDetail WasteStockAdjustmentDetail? @relation(fields: [wasteStockAdjustmentDetailId], references: [id])
  movement                   WasteMovement               @relation(fields: [movementId], references: [id], onDelete: Cascade)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([wasteId])
  @@index([wasteStockAdjustmentDetailId])
  @@index([movementId])
}

model Notification {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String      @db.VarChar(100)
  message         String      @db.VarChar(255)
  type            String      @default("info") @db.VarChar(20)
  isRead          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  entityId        String      @db.Uuid
  entityType      String      @db.VarChar(50)
  referenceNumber String?     @db.VarChar(50)
  userId          String?     @db.Uuid
  user            User?       @relation(fields: [userId], references: [id])
  departmentId    String?     @db.Uuid
  department      Department? @relation(fields: [departmentId], references: [id])
}

model Project {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNumber      String                @unique @db.VarChar(50)
  client               String                @db.VarChar(50)
  name                 String                @db.VarChar(50)
  date                 DateTime
  purchaseRequisitions PurchaseRequisition[]
  goodsIssues          GoodsIssue[]
}

model Client {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(255)
  advisorId   String?      @db.Uuid
  advisor     Person?      @relation(fields: [advisorId], references: [id])
  goodsIssues GoodsIssue[]
}

model ReferenceNumberCounter {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prefix  String @db.VarChar(10)
  counter Int    @default(0)
  year    Int    @default(0)

  @@unique([prefix, year])
}

model GoodsReceipt {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice                  String?                    @db.VarChar(50)
  isInvoiced               Boolean                    @default(false)
  supplierId               String                     @db.Uuid
  supplierName             String                     @db.VarChar(200)
  statusId                 String                     @db.Uuid
  receivedById             String                     @db.Uuid
  receivedByName           String                     @db.VarChar(255)
  referenceNumber          String                     @unique @db.VarChar(50)
  receptionDate            DateTime
  observations             String?                    @db.VarChar(500)
  totalQuantity            Decimal                    @db.Decimal(10, 2)
  totalNetPurchaseAmount   Decimal                    @db.Decimal(10, 2)
  totalGrossPurchaseAmount Decimal                    @db.Decimal(10, 2)
  receivedBy               Person                     @relation(fields: [receivedById], references: [id])
  supplier                 Supplier                   @relation(fields: [supplierId], references: [id])
  status                   Status                     @relation(fields: [statusId], references: [id])
  movements                InventoryMovement[]
  details                  GoodsReceiptDetail[]
  detailChanges            GoodsReceiptDetailChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoodsReceiptDetail {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId          String                     @db.Uuid
  goodsReceiptId      String                     @db.Uuid
  quantity            Decimal                    @db.Decimal(10, 2)
  conversionUnitCost  Decimal                    @db.Decimal(10, 2)
  costPerUnitType     Decimal                    @db.Decimal(10, 2)
  convertedQuantity   Decimal                    @db.Decimal(10, 2)
  netPurchaseAmount   Decimal                    @db.Decimal(10, 2)
  grossPurchaseAmount Decimal                    @db.Decimal(10, 2)
  presentationId      String                     @db.Uuid
  presentationName    String                     @db.VarChar(50)
  unitMeasureId       String                     @db.Uuid
  unitMeasureName     String                     @db.VarChar(20)
  unitMeasureSymbol   String                     @db.VarChar(10)
  materialName        String                     @db.VarChar(200)
  materialBase        Decimal?                   @db.Decimal(10, 2)
  materialHeight      Decimal?                   @db.Decimal(10, 2)
  status              GoodsReceiptDetailStatus   @default(ACTIVE)
  goodsReceipt        GoodsReceipt               @relation(fields: [goodsReceiptId], references: [id])
  material            Material                   @relation(fields: [materialId], references: [id])
  movementDetails     MovementDetail[]
  changes             GoodsReceiptDetailChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GoodsReceiptDetailStatus {
  ACTIVE
  CANCELED
}

model PurchaseRequisition {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNumber String    @unique @db.VarChar(50)
  approveDate     DateTime?
  requestDate     DateTime
  deliveryDate    DateTime?
  observations    String?   @db.VarChar(500)

  statusId      String  @db.Uuid
  departmentId  String  @db.Uuid
  approverId    String? @db.Uuid
  deliveredById String? @db.Uuid
  requesterId   String  @db.Uuid
  projectId     String  @db.Uuid

  department  Department @relation(fields: [departmentId], references: [id])
  approver    Person?    @relation("ApproverRelation", fields: [approverId], references: [id])
  deliveredBy Person?    @relation("DeliveredByRelation", fields: [deliveredById], references: [id])
  requester   Person     @relation("RequesterRelation", fields: [requesterId], references: [id])
  status      Status     @relation(fields: [statusId], references: [id])
  project     Project    @relation(fields: [projectId], references: [id])

  details PurchaseRequisitionDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseRequisitionDetail {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId            String  @db.Uuid
  purchaseRequisitionId String  @db.Uuid
  quantity              Decimal @db.Decimal(10, 2)

  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id])
  material            Material            @relation(fields: [materialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoodsIssue {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNumber String    @unique @db.VarChar(50)
  approvedDate    DateTime?
  requestDate     DateTime
  deliveryDate    DateTime?
  observations    String?   @db.VarChar(500)
  projectNumber   String    @db.VarChar(10)
  departmentName  String    @db.VarChar(50)
  requesterName   String    @db.VarChar(255)
  clientName      String    @db.VarChar(255)
  advisorName     String    @db.VarChar(255)

  statusId            String  @db.Uuid
  departmentId        String  @db.Uuid
  approverId          String? @db.Uuid
  requesterId         String  @db.Uuid
  warehouseStaffId    String? @db.Uuid
  projectId           String? @db.Uuid
  clientId            String  @db.Uuid
  advisorId           String  @db.Uuid
  fulfillmentStatusId String? @db.Uuid

  department        Department         @relation(fields: [departmentId], references: [id])
  approver          Person?            @relation("ApproverGoodsIssueRelation", fields: [approverId], references: [id])
  requester         Person             @relation("RequesterGoodsIssueRelation", fields: [requesterId], references: [id])
  warehouseStaff    Person?            @relation("WarehouseStaffGoodsIssueRelation", fields: [warehouseStaffId], references: [id])
  status            Status             @relation(fields: [statusId], references: [id])
  project           Project?           @relation(fields: [projectId], references: [id])
  client            Client             @relation(fields: [clientId], references: [id])
  advisor           Person             @relation(fields: [advisorId], references: [id])
  fulfillmentStatus FulfillmentStatus? @relation(fields: [fulfillmentStatusId], references: [id])

  details   GoodsIssueDetail[]
  movements InventoryMovement[]
  returns   GoodsIssueReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoodsIssueDetail {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId   String @db.Uuid
  goodsIssueId String @db.Uuid
  supplierId   String @db.Uuid

  presentationId              String   @db.Uuid
  unitMeasureId               String   @db.Uuid
  materialName                String   @db.VarChar(200)
  supplierName                String   @db.VarChar(200)
  materialBase                Decimal? @db.Decimal(10, 2)
  materialHeight              Decimal? @db.Decimal(10, 2)
  quantity                    Decimal  @db.Decimal(10, 2)
  applyWaste                  Boolean  @default(false)
  presentationName            String   @db.VarChar(50)
  convertedQuantity           Decimal  @db.Decimal(10, 2)
  unitMeasureName             String   @db.VarChar(20)
  unitMeasureSymbol           String   @db.VarChar(10)
  maxUnitCost                 Decimal  @db.Decimal(10, 2)
  projectConvertedQuantity    Decimal? @db.Decimal(10, 2)
  convertedQuantityDifference Decimal? @db.Decimal(10, 2)
  suppliedQuantity            Decimal? @db.Decimal(10, 2)
  returnedQuantity            Decimal  @default(0) @db.Decimal(10, 2)
  isSupplied                  Boolean  @default(false)
  fulfillmentStatusId         String   @db.Uuid

  presentation      Presentation       @relation(fields: [presentationId], references: [id])
  unitMeasure       UnitMeasure        @relation(fields: [unitMeasureId], references: [id])
  material          Material           @relation(fields: [materialId], references: [id])
  supplier          Supplier           @relation(fields: [supplierId], references: [id])
  goodsIssue        GoodsIssue         @relation(fields: [goodsIssueId], references: [id])
  fulfillmentStatus FulfillmentStatus  @relation(fields: [fulfillmentStatusId], references: [id], onDelete: Restrict)
  movementDetails   MovementDetail[]
  returns           GoodsIssueReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoodsIssueReturn {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  goodsIssueId       String  @db.Uuid
  goodsIssueDetailId String  @db.Uuid
  movementDetailId   String? @unique @db.Uuid
  returnedById       String? @db.Uuid

  materialId     String   @db.Uuid
  materialName   String   @db.VarChar(200)
  supplierId     String   @db.Uuid
  supplierName   String   @db.VarChar(200)
  materialBase   Decimal? @db.Decimal(10, 2)
  materialHeight Decimal? @db.Decimal(10, 2)

  currentTotalReturnedQuantity Decimal @db.Decimal(10, 2)
  newTotalReturnedQuantity     Decimal @db.Decimal(10, 2)
  observations                 String? @db.VarChar(500)

  goodsIssue       GoodsIssue       @relation(fields: [goodsIssueId], references: [id])
  goodsIssueDetail GoodsIssueDetail @relation(fields: [goodsIssueDetailId], references: [id])
  movementDetail   MovementDetail?  @relation(fields: [movementDetailId], references: [id], onDelete: SetNull)
  returnedBy       User?            @relation(fields: [returnedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsIssueId])
  @@index([goodsIssueDetailId])
  @@index([returnedById])
}

model FulfillmentStatus {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @unique @db.VarChar(50)
  goodsIssues       GoodsIssue[]
  goodsIssueDetails GoodsIssueDetail[]
}

model InventoryMovement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  referenceNumber String? @unique @db.VarChar(50)

  type InventoryMovementType

  goodsReceiptId    String? @db.Uuid
  goodsIssueId      String? @db.Uuid
  stockAdjustmentId String? @unique @db.Uuid

  date DateTime @default(now())

  goodsReceipt             GoodsReceipt?             @relation(fields: [goodsReceiptId], references: [id])
  goodsIssue               GoodsIssue?               @relation(fields: [goodsIssueId], references: [id])
  stockAdjustment          StockAdjustment?          @relation(fields: [stockAdjustmentId], references: [id])
  goodsReceiptDetailChange GoodsReceiptDetailChange?
  details                  MovementDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovementDetail {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  quantity Decimal @db.Decimal(10, 2)

  newStock      Decimal? @db.Decimal(10, 2)
  previousStock Decimal? @db.Decimal(10, 2)

  materialId              String   @db.Uuid
  materialBase            Decimal? @db.Decimal(10, 2)
  materialHeight          Decimal? @db.Decimal(10, 2)
  supplierId              String   @db.Uuid
  goodsReceiptDetailId    String?  @db.Uuid
  goodsIssueDetailId      String?  @db.Uuid
  stockAdjustmentDetailId String?  @db.Uuid
  movementId              String   @db.Uuid

  material              Material               @relation(fields: [materialId], references: [id])
  supplier              Supplier               @relation(fields: [supplierId], references: [id])
  goodsReceiptDetail    GoodsReceiptDetail?    @relation(fields: [goodsReceiptDetailId], references: [id])
  goodsIssueDetail      GoodsIssueDetail?      @relation(fields: [goodsIssueDetailId], references: [id])
  stockAdjustmentDetail StockAdjustmentDetail? @relation(fields: [stockAdjustmentDetailId], references: [id])
  movement              InventoryMovement      @relation(fields: [movementId], references: [id])
  goodsIssueReturn      GoodsIssueReturn?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockAdjustment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  referenceNumber String @unique @db.VarChar(50)

  type         StockAdjustmentType
  reasonId     String              @db.Uuid
  observations String?             @db.VarChar(500)

  status AdjustmentStatus @default(PENDING)

  createdById  String  @db.Uuid
  approvedById String? @db.Uuid

  reason     StockAdjustmentReason @relation(fields: [reasonId], references: [id])
  createdBy  User                  @relation("CreatedStockAdjustments", fields: [createdById], references: [id])
  approvedBy User?                 @relation("ApprovedStockAdjustments", fields: [approvedById], references: [id])

  movement InventoryMovement?

  details StockAdjustmentDetail[]

  appliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdjustmentStatus {
  PENDING
  APPLIED
  CANCELLED
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
}

model StockAdjustmentDetail {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  stockAdjustmentId String @db.Uuid

  materialId   String @db.Uuid
  supplierId   String @db.Uuid
  materialName String @db.VarChar(200)
  supplierName String @db.VarChar(200)

  previousStock Decimal @db.Decimal(10, 2)
  newStock      Decimal @db.Decimal(10, 2)
  difference    Decimal @db.Decimal(10, 2)

  previousConvertedQuantity Decimal @db.Decimal(10, 2)
  newConvertedQuantity      Decimal @db.Decimal(10, 2)
  convertedDifference       Decimal @db.Decimal(10, 2)

  materialBase   Decimal? @db.Decimal(10, 2)
  materialHeight Decimal? @db.Decimal(10, 2)

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id])

  material Material @relation(fields: [materialId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  movementDetails MovementDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InventoryMovementType {
  ENTRY
  ISSUE
  ADJUSTMENT
}

model GoodsReceiptDetailChange {
  id                          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goodsReceiptId              String  @db.Uuid
  goodsReceiptDetailId        String  @db.Uuid
  reasonId                    String  @db.Uuid
  inventoryMovementId         String? @unique @db.Uuid
  previousMaterialId          String  @db.Uuid
  previousMaterialName        String  @db.VarChar(200)
  previousQuantity            Decimal @db.Decimal(10, 2)
  previousCostPerUnitType     Decimal @db.Decimal(10, 2)
  previousNetPurchaseAmount   Decimal @db.Decimal(10, 2)
  previousGrossPurchaseAmount Decimal @db.Decimal(10, 2)

  correctedMaterialId          String  @db.Uuid
  correctedMaterialName        String  @db.VarChar(200)
  correctedQuantity            Decimal @db.Decimal(10, 2)
  correctedCostPerUnitType     Decimal @db.Decimal(10, 2)
  correctedNetPurchaseAmount   Decimal @db.Decimal(10, 2)
  correctedGrossPurchaseAmount Decimal @db.Decimal(10, 2)

  changeType         GoodsReceiptDetailChangeType
  materialChanged    Boolean                      @default(false)
  quantityDifference Decimal                      @db.Decimal(10, 2)
  costDifference     Decimal                      @db.Decimal(10, 2)

  goodsReceipt       GoodsReceipt          @relation(fields: [goodsReceiptId], references: [id])
  goodsReceiptDetail GoodsReceiptDetail    @relation(fields: [goodsReceiptDetailId], references: [id])
  reason             StockAdjustmentReason @relation(fields: [reasonId], references: [id])
  previousMaterial   Material              @relation("PreviousGoodsReceiptDetailChangeMaterial", fields: [previousMaterialId], references: [id])
  correctedMaterial  Material              @relation("CorrectedGoodsReceiptDetailChangeMaterial", fields: [correctedMaterialId], references: [id])
  inventoryMovement  InventoryMovement?    @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsReceiptId])
  @@index([goodsReceiptDetailId])
  @@index([reasonId])
  @@index([previousMaterialId])
  @@index([correctedMaterialId])
}

enum GoodsReceiptDetailChangeType {
  QUANTITY
  COST
  QUANTITY_AND_COST
  CANCELLATION
}

model StockAdjustmentReason {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name String @unique @db.VarChar(100)

  isActive Boolean @default(true)

  stockAdjustments          StockAdjustment[]
  goodsReceiptDetailChanges GoodsReceiptDetailChange[]
  wasteStockAdjustments     WasteStockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
