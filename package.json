{
  "name": "nexus",
  "version": "1.0.0",
  "description": "Plataforma de control operativo",
  "main": "src/app.js",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.4"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "vitest run --config vitestConfig.js",
    "test:unit": "vitest run --config vitestConfig.js",
    "test:coverage": "vitest run --config vitestConfig.js --coverage",
    "test:coverage:integration": "npm run test:integration -- --coverage",
    "test:watch": "vitest watch --config vitestConfig.js",
    "test:db:migrate": "npm run test:db:verify && cross-env NODE_ENV=test prisma migrate deploy && cross-env NODE_ENV=test prisma generate",
    "test:integration": "npm run test:db:verify && cross-env NODE_ENV=test prisma migrate deploy && cross-env NODE_ENV=test prisma generate && vitest run --config vitestIntegrationConfig.js",
    "test:performance": "npm run test:db:migrate && cross-env NODE_ENV=test node --import=dotenv/config tests/performance/backendBenchmark.js",
    "test:performance:mixed": "npm run test:db:migrate && cross-env NODE_ENV=test node --import=dotenv/config tests/performance/backendMixedBenchmark.js",
    "test:db": "npm run test:integration",
    "test:db:verify": "node scripts/verifyTestDatabaseEnv.js",
    "docs:architecture": "node scripts/generateArchitectureDocs.js",
    "docs:check": "node scripts/generateArchitectureDocs.js --check && node scripts/checkOpenApiContract.js",
    "docs:export": "node scripts/exportDocs.js",
    "docs:screenshots": "node scripts/runManualScreenshotWorkflow.js",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:generate": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpgsistemas01/SistemaMerma.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/gpgsistemas01/SistemaMerma/issues"
  },
  "homepage": "https://github.com/gpgsistemas01/SistemaMerma#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "10.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "4.1.12",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
