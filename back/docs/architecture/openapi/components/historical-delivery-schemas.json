{
  "HistoricalDeliveryEvidence": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "reason": {
        "type": "string"
      },
      "cutoffDate": {
        "type": "string",
        "format": "date-time"
      },
      "deliveredAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "user": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "id",
      "reason",
      "cutoffDate",
      "deliveredAt",
      "createdAt",
      "user"
    ]
  },
  "HistoricalDeliveryCommand": {
    "type": "object",
    "required": [
      "operationId",
      "documents",
      "cutoffDate",
      "reason",
      "declaredDelivered"
    ],
    "properties": {
      "operationId": {
        "type": "string",
        "format": "uuid"
      },
      "documents": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "cutoffDate": {
        "type": "string",
        "format": "date-time",
        "description": "Instante de corte con zona horaria, nunca futuro."
      },
      "deliveredAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time",
        "description": "Opcional, sólo si se conoce; entre solicitud y corte."
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "declaredDelivered": {
        "type": "boolean",
        "const": true
      }
    }
  },
  "HistoricalDeliveryCandidate": {
    "type": "object",
    "required": [
      "id",
      "revision",
      "referenceNumber",
      "requestDate",
      "departmentName",
      "projectNumber",
      "details"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "revision": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "referenceNumber": {
        "type": "string"
      },
      "requestDate": {
        "type": "string",
        "format": "date-time"
      },
      "departmentName": {
        "type": "string"
      },
      "projectNumber": {
        "type": "string"
      },
      "details": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "quantity": {
              "type": "number",
              "minimum": 0
            },
            "suppliedQuantity": {
              "type": "number",
              "minimum": 0
            },
            "returnedQuantity": {
              "type": "number",
              "minimum": 0
            },
            "pendingQuantity": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "HistoricalDeliveryPreviewResponse": {
    "type": "object",
    "required": [
      "preview"
    ],
    "properties": {
      "preview": {
        "type": "object",
        "required": [
          "resource",
          "cutoffDate",
          "page",
          "hasMore",
          "documents",
          "total"
        ],
        "properties": {
          "resource": {
            "enum": [
              "materials",
              "consumables",
              "wastes"
            ]
          },
          "cutoffDate": {
            "type": "string",
            "format": "date-time"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "hasMore": {
            "type": "boolean"
          },
          "documents": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "../openapi.json#/components/schemas/HistoricalDeliveryCandidate"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Total de salidas elegibles; páginas de 100 registros."
          }
        }
      }
    }
  },
  "HistoricalDeliveryResponse": {
    "type": "object",
    "required": [
      "code",
      "receipt",
      "replayed"
    ],
    "properties": {
      "code": {
        "const": "HISTORICAL_DELIVERY_COMPLETED"
      },
      "replayed": {
        "type": "boolean"
      },
      "receipt": {
        "type": "object",
        "required": [
          "id",
          "resource",
          "documents",
          "costsVerified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "resource": {
            "enum": [
              "materials",
              "consumables",
              "wastes"
            ]
          },
          "cutoffDate": {
            "type": "string",
            "format": "date-time"
          },
          "deliveredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "registeredBy": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "declaredDelivered": {
            "const": true
          },
          "costsVerified": {
            "const": false
          },
          "documents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "allOf": [
                {
                  "$ref": "../openapi.json#/components/schemas/HistoricalDeliveryCandidate"
                },
                {
                  "type": "object",
                  "properties": {
                    "before": {
                      "type": "object"
                    },
                    "recognized": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "detailId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "quantity": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        }
                      }
                    },
                    "fulfillmentStatus": {
                      "const": "Surtido"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
