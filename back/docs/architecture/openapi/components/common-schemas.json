{
  "SuccessCode": {
    "type": "string",
    "description": "Código estable consumido por la interfaz."
  },
  "Error": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "meta": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "ValidationError": {
    "type": "object",
    "properties": {
      "code": {
        "const": "VALIDATION_ERROR"
      },
      "errors": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false,
    "required": [
      "code",
      "errors"
    ]
  },
  "NamedCatalog": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "key": {
        "type": "string"
      },
      "name": {
        "type": "string"
      }
    },
    "additionalProperties": true,
    "required": [
      "id",
      "name"
    ],
    "description": "Identidad y nombre de catálogo o estado; puede incluir metadatos persistidos de auditoría."
  },
  "NamedCatalogList": {
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "../openapi.json#/components/schemas/NamedCatalog"
        }
      },
      "recordsTotal": {
        "type": "integer"
      },
      "recordsFiltered": {
        "type": "integer"
      }
    },
    "additionalProperties": false,
    "required": [
      "data",
      "recordsTotal",
      "recordsFiltered"
    ]
  },
  "CodeResponse": {
    "type": "object",
    "properties": {
      "code": {
        "$ref": "../openapi.json#/components/schemas/SuccessCode"
      }
    },
    "additionalProperties": false,
    "required": [
      "code"
    ]
  }
}
