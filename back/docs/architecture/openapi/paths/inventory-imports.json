{
  "/api/warehouse/inventory-imports/{resource}/template": {
    "get": {
      "operationId": "getInventoryImportTemplate",
      "tags": [
        "Importaciones de inventario"
      ],
      "summary": "Descargar plantilla de una operación con estructura de inventario",
      "description": "Una operación para todo el archivo: create (Alta), update (Editar datos) o adjust (Ajustar existencias). Columnas iniciales y orden del reporte de inventario; después Activo, IDs/versiones y campos de captura. Ajuste omite costos. IDs/versiones incluidos automáticamente para toda cuenta con permiso operativo, sin exigir administrador. Alta genera IDs y captura Cantidad inicial; edición conserva stock; ajuste usa Stock contado final con motivo/observaciones, cero válido y vacío rechazado. Hasta 100 filas/2 MiB y catálogos de 500 opciones. La plantilla identifica módulo y operación; se rechaza una selección incompatible. Merma usa referencia existente y proveedor filtrado.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "resource",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "materials",
              "consumables",
              "wastes"
            ]
          }
        },
        {
          "name": "mode",
          "in": "query",
          "schema": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "adjust"
            ],
            "default": "create"
          }
        },
        {
          "name": "supplierId",
          "in": "query",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Obligatorio para la plantilla de alta de mermas. En actualización delimita las relaciones del proveedor."
        },
        {
          "name": "search",
          "in": "query",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        },
        {
          "name": "page",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "default": 1
          },
          "description": "Edición o ajuste: 100 filas por página, orden estable por nombre e identificador."
        }
      ],
      "responses": {
        "200": {
          "description": "Libro XLSX generado en memoria; Cache-Control: no-store.",
          "content": {
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "400": {
          "description": "Archivo o captura inválida; revisar fila/columna de la vista previa.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Lote propio inexistente.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "409": {
          "description": "Conflicto de versión, identidad, estado o clave de operación; no se aplica parcialmente el lote.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "410": {
          "description": "Borrador vencido.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "413": {
          "description": "Se excedió un límite de archivo, filas o tiempo de análisis.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "429": {
          "description": "Hay otro trabajo de importación o no se pudo adquirir el bloqueo a tiempo. Reintentar con la misma clave.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      }
    }
  },
  "/api/warehouse/inventory-imports/{resource}/preview": {
    "post": {
      "operationId": "postInventoryImportPreview",
      "tags": [
        "Importaciones de inventario"
      ],
      "summary": "Validar archivo sin cambiar el inventario",
      "description": "Autoriza la operación seleccionada para todo el archivo antes del multipart. Analiza un único XLSX con SheetKit en worker y comprueba formato V2, módulo, operación, encabezados, permisos, duplicados, versiones, identidad y conteo final. No deduce la operación por fila o por nombre. Un error bloquea todo el archivo sin modificar inventario. Hasta 100 filas/2 MiB.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "resource",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "materials",
              "consumables",
              "wastes"
            ]
          }
        },
        {
          "name": "mode",
          "in": "query",
          "schema": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "adjust"
            ],
            "default": "create"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Lote privado, vista previa o recibo persistido.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/InventoryImportResponse"
              }
            }
          }
        },
        "400": {
          "description": "Archivo o captura inválida; revisar fila/columna de la vista previa.",
          "content": {
            "application/json": {
