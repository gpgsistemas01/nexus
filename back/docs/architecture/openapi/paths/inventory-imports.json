{
  "/api/warehouse/inventory-imports/{resource}/template": {
    "get": {
      "operationId": "getInventoryImportTemplate",
      "tags": [
        "Importaciones de inventario"
      ],
      "summary": "Descargar archivo único para altas, ediciones y conteos",
      "description": "La interfaz usa mode=mixed: operacion por fila Alta, Editar, Ajustar, Editar y ajustar o Conservar. Hasta 100 filas y 2 MiB. Registros actuales con IDs/versiones originales, saldos de referencia y stock_contado_o_inicial vacío. Alta usa existencia inicial y genera ID; editar conserva stock/identidad; ajuste reemplaza el saldo por el conteo físico final y exige motivo activo y observaciones. Cero es válido, vacío de conteo se rechaza. Conservar no cambia datos. Un destino ocupa una fila. Alta/edición requiere lectura, escritura y inventory:costs-read; conteo requiere lectura y ajuste del recurso. Mixto autoriza cada operación antes de leer costos. Un error bloquea todo el archivo. create/update/adjust conservan recuperación de contratos anteriores. Catálogos hasta 500 opciones; merma usa material de referencia existente y proveedor filtrado.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "resource",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "materials",
              "consumables",
              "wastes"
            ]
          }
        },
        {
          "name": "mode",
          "in": "query",
          "schema": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "adjust",
              "mixed"
            ],
            "default": "create"
          }
        },
        {
          "name": "supplierId",
          "in": "query",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Obligatorio para la plantilla de alta de mermas. En actualización delimita las relaciones del proveedor."
        },
        {
          "name": "search",
          "in": "query",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        },
        {
          "name": "page",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "default": 1
          },
          "description": "Actualización: 100 filas por página, orden estable por nombre e identificador."
        }
      ],
      "responses": {
        "200": {
          "description": "Libro XLSX generado en memoria; Cache-Control: no-store.",
          "content": {
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "400": {
          "description": "Archivo o captura inválida; revisar fila/columna de la vista previa.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Lote propio inexistente.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "409": {
          "description": "Conflicto de versión, identidad, estado o clave de operación; no se aplica parcialmente el lote.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "410": {
          "description": "Borrador vencido.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "413": {
          "description": "Se excedió un límite de archivo, filas o tiempo de análisis.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "429": {
          "description": "Hay otro trabajo de importación o no se pudo adquirir el bloqueo a tiempo. Reintentar con la misma clave.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      }
    }
  },
