{
  "/api/warehouse/historical-deliveries/{resource}/preview": {
    "get": {
      "operationId": "previewHistoricalDeliveryBatch",
      "summary": "Revisar entregas históricas pendientes por corte",
      "description": "Requiere issues:reconcile para Administrador en Sistemas o Coordinador en Almacén. Conserva alcance de área y tipo. Excluye canceladas, ya conciliadas y solicitudes posteriores al corte. Devuelve el total de salidas con partidas realmente pendientes, en páginas de 100 registros, y revisiones originales para selección explícita. No cambia existencias.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "resource",
          "in": "path",
          "required": true,
          "schema": {
            "enum": [
              "materials",
              "consumables",
              "wastes"
            ]
          }
        },
        {
          "name": "cutoffDate",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "format": "date-time"
          }
        },
        {
          "name": "page",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "default": 1
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Resultado correcto; Cache-Control: no-store.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/HistoricalDeliveryPreviewResponse"
              }
            }
          }
        },
        "400": {
          "description": "Captura o declaración inválida."
        },
        "401": {
          "description": "Sesión requerida."
        },
        "403": {
          "description": "Sin issues:reconcile."
        },
        "404": {
          "description": "Salida fuera de alcance o contexto."
        },
        "409": {
          "description": "Revisión vieja, cancelada, sin pendiente, clave distinta u operación ocupada."
        },
        "500": {
          "description": "Error sin efectos parciales."
        }
      },
      "tags": [
        "Conciliación histórica"
      ]
    }
  },
  "/api/warehouse/historical-deliveries/{resource}/confirm": {
    "post": {
      "operationId": "confirmHistoricalDeliveryBatch",
      "summary": "Registrar hasta 100 entregas físicas históricas sin otro descuento",
      "description": "Una transacción bloquea los folios y comprueba sus revisiones, reconoce sólo quantity-suppliedQuantity y conserva devoluciones, costos y proyecto. No escribe saldos ni movimientos. Guarda actor, motivo, antes/reconocido y recibo durable. Reintentar el mismo comando y operationId devuelve ese recibo. Fecha real sólo si conocida; registro lo fija servidor. Una devolución posterior exige physicalReturnConfirmed=true y representa entrada física actual.",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "resource",
          "in": "path",
          "required": true,
          "schema": {
            "enum": [
              "materials",
              "consumables",
              "wastes"
            ]
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/HistoricalDeliveryCommand"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Resultado correcto; Cache-Control: no-store.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/HistoricalDeliveryResponse"
              }
            }
          }
        },
        "400": {
          "description": "Captura o declaración inválida."
        },
        "401": {
          "description": "Sesión requerida."
        },
        "403": {
          "description": "Sin issues:reconcile."
        },
        "404": {
          "description": "Salida fuera de alcance o contexto."
        },
        "409": {
          "description": "Revisión vieja, cancelada, sin pendiente, clave distinta u operación ocupada."
        },
        "500": {
          "description": "Error sin efectos parciales."
        }
      },
      "tags": [
        "Conciliación histórica"
      ]
    }
  }
}
