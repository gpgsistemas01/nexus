  "/api/admin/catalogs/{catalog}": {
    "get": {
      "operationId": "getManagedCatalog",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "parameters": [
        {
          "name": "catalog",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "departments",
              "roles",
              "presentations",
              "unit-measures",
              "reasons",
              "fulfillment-statuses"
            ]
          }
        },
        {
          "name": "start",
          "in": "query",
          "required": false,
          "description": "Desplazamiento entero. Inválido o fuera de rango se normaliza a 0.",
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 0
          }
        },
        {
          "name": "length",
          "in": "query",
          "required": false,
          "description": "Tamaño de página; valores superiores se limitan a 100. Cero devuelve sólo conteos. Inválido usa 10; negativo se normaliza a 0.",
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 10
          }
        },
        {
          "name": "search[value]",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data",
                  "recordsTotal",
                  "recordsFiltered"
                ],
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "recordsTotal": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "recordsFiltered": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
