{
  "/api/sales/clients": {
    "get": {
      "operationId": "getSalesClients",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/ClientList"
              },
              "example": {
                "data": [],
                "recordsTotal": 0,
                "recordsFiltered": 0
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      },
      "tags": [
        "Clientes"
      ],
      "summary": "Consultar clientes",
      "parameters": [
        {
          "name": "order[0][column]",
          "in": "query",
          "description": "Índice de orden: 0=name, 1=isActive. Otros índices usan la primera columna admitida.",
          "schema": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        },
        {
          "$ref": "../openapi.json#/components/parameters/Start"
        },
        {
          "$ref": "../openapi.json#/components/parameters/Length"
        },
        {
          "$ref": "../openapi.json#/components/parameters/Search"
        },
        {
          "$ref": "../openapi.json#/components/parameters/OrderDirection"
        },
        {
          "$ref": "../openapi.json#/components/parameters/AdvisorId"
        },
        {
          "$ref": "../openapi.json#/components/parameters/OnlyActive"
        }
      ]
    },
    "post": {
      "operationId": "postSalesClients",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/ClientResponse"
              },
              "example": {
                "code": "CREATED_CLIENT",
                "client": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "name": "CLIENTE DE EJEMPLO",
                  "isActive": true,
                  "version": 0
                }
              }
            }
          }
        },
        "400": {
          "$ref": "../openapi.json#/components/responses/ValidationError"
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      },
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/ClientRequest"
            },
            "example": {
              "name": "CLIENTE DE EJEMPLO",
              "isActive": true
            }
          }
        }
      },
      "tags": [
        "Clientes"
      ],
      "summary": "Crear cliente"
    }
  },
  "/api/sales/clients/{id}": {
    "put": {
      "operationId": "putSalesClientsId",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/ClientResponse"
              }
            }
          }
        },
        "400": {
          "$ref": "../openapi.json#/components/responses/ValidationError"
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "404": {
          "description": "El registro o el detalle no está disponible en el contexto solicitado. Conserva el código del dominio.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/Error"
              }
            }
          }
        },
        "409": {
          "$ref": "../openapi.json#/components/responses/WriteConflict"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      },
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/ClientUpdateRequest"
            },
            "example": {
              "name": "CLIENTE DE EJEMPLO",
              "isActive": true,
              "expectedVersion": 0
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "description": "UUID del registro."
        }
      ],
      "tags": [
        "Clientes"
      ],
      "summary": "Editar cliente"
    }
  },
  "/api/sales/reports/clients/excel": {
    "get": {
      "operationId": "getSalesReportsClientsExcel",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      },
      "tags": [
        "Clientes"
      ],
      "summary": "Exportar clientes a Excel",
      "parameters": [
        {
          "name": "order[0][column]",
          "in": "query",
          "description": "Índice de orden: 0=name. Otros índices usan la primera columna admitida.",
          "schema": {
            "type": "integer",
            "enum": [
              0
            ]
          }
        },
        {
          "$ref": "../openapi.json#/components/parameters/Search"
        },
        {
          "$ref": "../openapi.json#/components/parameters/OrderDirection"
        },
        {
          "$ref": "../openapi.json#/components/parameters/AdvisorId"
        }
      ]
    }
  }
}
