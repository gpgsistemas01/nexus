{
  "/api/auth/login": {
    "post": {
      "operationId": "postAuthLogin",
      "security": [],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/CodeResponse"
              },
              "example": {
                "code": "SUCCESS_LOGIN"
              }
            }
          },
          "headers": {
            "Set-Cookie": {
              "description": "Cabecera repetida para accessToken y refreshToken. HttpOnly, SameSite=Lax y Secure en producci\u00f3n.",
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "400": {
          "$ref": "../openapi.json#/components/responses/ValidationError"
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      },
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../openapi.json#/components/schemas/LoginRequest"
            },
            "example": {
              "name": "usuario_ejemplo",
              "password": "Clave_de_ejemplo1!"
            }
          }
        }
      },
      "tags": [
        "Sesi\u00f3n"
      ],
      "summary": "Iniciar sesi\u00f3n",
      "description": "Valida credenciales y emite accessToken y refreshToken como cookies HttpOnly; no devuelve tokens en JSON."
    }
  },
  "/api/auth/me": {
    "get": {
      "operationId": "getAuthMe",
      "security": [
        {
          "cookieAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../openapi.json#/components/schemas/CurrentUserResponse"
              },
              "example": {
                "user": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "name": "usuario_ejemplo",
                  "permissions": [],
                  "accesses": []
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      },
      "tags": [
        "Sesi\u00f3n"
      ],
      "summary": "Consultar la sesi\u00f3n actual",
      "description": "Devuelve la cuenta y los permisos vigentes de la sesi\u00f3n autenticada con accessToken."
    }
  },
  "/api/auth/refresh": {
    "post": {
      "operationId": "postAuthRefresh",
      "security": [
        {
          "refreshCookieAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Respuesta correcta.",
          "content": {
            "text/plain": {
              "schema": {
                "type": "string",
                "const": "OK"
              },
              "example": "OK"
            }
          },
          "headers": {
            "Set-Cookie": {
              "description": "Cabecera repetida para accessToken y refreshToken. HttpOnly, SameSite=Lax y Secure en producci\u00f3n.",
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "401": {
          "$ref": "../openapi.json#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "../openapi.json#/components/responses/Forbidden"
        },
        "500": {
          "$ref": "../openapi.json#/components/responses/ServerError"
        },
        "503": {
          "$ref": "../openapi.json#/components/responses/DatabaseSchemaUnavailable"
        }
      },
      "tags": [
        "Sesi\u00f3n"
      ],
      "summary": "Renovar el acceso",
      "description": "Renueva las dos cookies usando refreshToken. No requiere un accessToken vigente; devuelve texto OK."
    }
  }
}
