<div class="<%= item.cardClass || 'border rounded p-2 h-100 bg-light' %>">
    <span class="d-block small text-muted mb-1"><%= item.label %></span>
    <span id="<%= item.id %>" class="<%= item.valueClass || 'fw-semibold' %>"
        <% if (item.rawValue !== undefined) { %> data-value="<%= item.rawValue %>"<% } %>>
        <%= item.value %>
    </span>
</div>
